# APEX environment configuration (TEMPLATE — DO NOT COMMIT SECRETS)
# Copy this file to .env and fill in only the variables you need.
#
# The repository tracks only this template. Real secrets MUST be
# supplied via your deployment platform's secret manager (Vercel env,
# AWS Parameter Store, Kubernetes Secret, etc.) — never committed
# to the repository.

# ----- Runtime -----

# 'production' disables the GitHub/Jira/Linear/Slack mock paths.
# Set this to 'production' in any deployed environment.
NODE_ENV=development

# Port the API server binds to.
PORT=5173

# Absolute path to the durable database directory. The directory is
# created if it does not exist. The supported architecture is
# single-process; do not share this directory between processes.
DATABASE_PATH=./dev-database

# ----- Provider credentials -----
# Each token MUST be set via your secret manager, never hard-coded.

# GitHub: a real GitHub personal access token (ghp_, github_pat_, gho_,
# ghu_, ghs_, ghr_ prefix). Required for the GitHub adapter to make
# real API calls. In NODE_ENV=production, the absence of a real token
# is a hard error — the adapter refuses to silently execute a mock.
GITHUB_TOKEN=

# OpenAI: required for the OpenAIResponsesProvider. The provider
# refuses to instantiate without a real key.
OPENAI_API_KEY=

# Jira, Linear, Slack: these adapters are currently test-only mocks.
# Even if you supply real tokens, the production code paths will
# throw SecurityError. See docs/ROADMAP.md for the integration
# status.
JIRA_TOKEN=
LINEAR_TOKEN=
SLACK_TOKEN=

# ----- Logging -----

# Set to 'debug' for verbose logs. Production should leave this
# unset (info-level default).
# APEX_LOG_LEVEL=debug
